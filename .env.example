# CAMPUSX Configuration — Discover People Behind the Work System

# Database Configuration (MySQL is the exclusive database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campusx_db

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Security
SECRET_KEY=replace_with_your_own_secret_key

# Email / SMTP Configuration (Optional: Required for live reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@campusx.edu
SMTP_TLS=true
DEV_MODE=true
